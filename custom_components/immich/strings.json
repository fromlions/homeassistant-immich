{
  "config": {
    "step": {
      "user": {
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "api_key": "[%key:common::config_flow::data::api_key%]"
        }
      },
      "reauth_confirm": {
        "title": "Immich needs a new API key",
        "description": "Immich did not accept the stored API key. Enter a new one.",
        "data": {
          "api_key": "[%key:common::config_flow::data::api_key%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "reauth_successful": "[%key:common::config_flow::abort::reauth_successful%]"
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "watched_albums": "Albums for which entities will be created",
          "image_size": "Picture size",
          "refresh_interval": "New picture every (minutes)"
        },
        "data_description": {
          "image_size": "Preview is about 1440 pixels wide and loads fast. Full size is the whole picture converted to a web format and can be several megabytes.",
          "refresh_interval": "How often every picture entity loads a new random picture, from 1 minute to 24 hours."
        }
      }
    },
    "abort": {
      "invalid_auth": "[%key:common::config_flow::error::invalid_auth%]",
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]"
    }
  },
  "selector": {
    "image_size": {
      "options": {
        "preview": "Preview (recommended)",
        "fullsize": "Full size"
      }
    }
  }
}
